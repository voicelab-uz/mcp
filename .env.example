# VoiceLab API credentials
# Fallback API key for legacy Bearer token users (Cursor, Claude, Grok)
# OAuth users get per-user API keys from JWT voicelab_api_key claim
VOICELAB_API_KEY=vlk_your_fallback_api_key_here
VOICELAB_BASE_URL=https://api.voicelab.uz

# OAuth 2.1 (VoiceLab Authorization Server)
# OpenAI ChatGPT/Codex Plugins require OAuth with per-user API keys
# Leave empty to disable OAuth (legacy Bearer token only)
#
# CRITICAL: OAUTH_ISSUER must EXACTLY match the 'iss' claim in VoiceLab-issued JWTs
# Backend sets this via OAUTH_ISSUER_URL - ensure both are identical
# Example: if backend OAUTH_ISSUER_URL=https://auth.voicelab.uz, use same here
OAUTH_ISSUER=https://auth.voicelab.uz
#
# OAUTH_AUDIENCE must match the 'aud' claim in VoiceLab-issued JWTs
# This is the MCP resource identifier (this server's canonical URL)
OAUTH_AUDIENCE=https://mcp.voicelab.uz

# Legacy MCP Bearer token (for non-OAuth clients: Cursor, Claude, Grok)
# Can coexist with OAuth — OpenAI uses OAuth, others use legacy token
MCP_AUTH_TOKEN=your_secure_static_token_here

# HTTP server configuration
HOST=127.0.0.1
PORT=3100
MAX_BODY_BYTES=10485760
REQUEST_TIMEOUT_MS=120000
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# CORS (comma-separated browser origins)
ALLOWED_ORIGINS=https://chatgpt.com,https://chat.openai.com,https://grok.com
