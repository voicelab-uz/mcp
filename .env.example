# VoiceLab API credentials (required)
VOICELAB_API_KEY=vlk_your_api_key_here
VOICELAB_BASE_URL=https://api.voicelab.uz

# OAuth 2.1 / Auth0 configuration (for OpenAI ChatGPT/Codex Plugin support)
# Leave empty to disable OAuth (legacy Bearer token only)
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://mcp.voicelab.uz
AUTH0_ISSUER=https://your-tenant.auth0.com

# Legacy MCP Bearer token (fallback for non-OpenAI clients like Cursor, Claude, Grok)
# Both OAuth and legacy token can coexist — OpenAI uses OAuth, others can use legacy
MCP_AUTH_TOKEN=your_secure_token_here

# HTTP server configuration
HOST=127.0.0.1
PORT=3100
MAX_BODY_BYTES=10485760
REQUEST_TIMEOUT_MS=120000
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# CORS (comma-separated browser origins)
ALLOWED_ORIGINS=https://chatgpt.com,https://grok.com
