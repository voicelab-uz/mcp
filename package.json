{
  "name": "@voicelab/mcp",
  "version": "1.0.0",
  "description": "Official VoiceLab MCP server - AI agent integration for speech AI APIs",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "voicelab-mcp": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/voicelab-uz/mcp.git"
  },
  "bugs": {
    "url": "https://github.com/voicelab-uz/mcp/issues"
  },
  "homepage": "https://github.com/voicelab-uz/mcp#readme",
  "scripts": {
    "build": "tsc",
    "build:worker": "tsc -p tsconfig.worker.json",
    "start": "node dist/index.js",
    "start:stdio": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "dev": "wrangler dev",
    "deploy": "npm run build:worker && wrangler deploy",
    "deploy:staging": "npm run build:worker && wrangler deploy --env staging",
    "test": "npm run build && node dist/smoke-test.js",
    "test:e2e": "npm run build && node dist/e2e-test.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "voicelab",
    "tts",
    "stt",
    "speech",
    "transcription",
    "ai",
    "llm",
    "voice-isolation"
  ],
  "author": "Elzodxon Sharofaddinov <elzodxon@gmail.com>",
  "contributors": [
    "Elzodxon Sharofaddinov <elzodxon@gmail.com>"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "hono": "^4.13.11"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "wrangler": "^3.95.0"
  }
}
